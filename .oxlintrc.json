{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [".agents/**", "dist/**", "out/**", "src/gen/**"],
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": "allow",
    "curly": "error",
    "typescript/parameter-properties": "allow",
    "no-unused-vars": [
      "warn",
      {
        "fix": {
          "imports": "safe-fix",
          "variables": "off"
        }
      }
    ]
  }
}
